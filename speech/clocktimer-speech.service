[Unit]
Description=ClockTimer streaming speech recognition
After=network.target

[Service]
Type=simple
User=daemon
Group=daemon
WorkingDirectory=/opt/clocktimer-speech
Environment=NODE_ENV=production
Environment=SPEECH_HOST=127.0.0.1
Environment=SPEECH_PORT=8765
Environment=WHISPER_BIN=/opt/clocktimer-speech/bin/whisper-cli
Environment=WHISPER_MODEL=/var/lib/clocktimer/speech/models/ggml-base.en.bin
Environment=SPEECH_TMP=/var/lib/clocktimer/speech/tmp
ExecStart=/usr/bin/env node /opt/clocktimer-speech/src/server.js
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
