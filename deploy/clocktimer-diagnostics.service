[Unit]
Description=ClockTimer restricted diagnostics runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=daemon
Group=daemon
WorkingDirectory=/var/lib/clocktimer/diagnostics/runner
Environment=PATH=/opt/clocktimer-diagnostics-node/bin:/usr/bin:/bin
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/lib/clocktimer/diagnostics/browsers
ExecStart=/opt/clocktimer-diagnostics-node/bin/node services/diagnostics-worker.cjs
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=10
UMask=0077
CPUQuota=100%
MemoryMax=768M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/clocktimer/diagnostics

[Install]
WantedBy=multi-user.target
